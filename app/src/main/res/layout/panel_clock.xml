<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPanelAppName"
            style="@style/Glass.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPanelCredit"
            style="@style/Glass.Hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="by Minh Thái"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPanelSize"
        style="@style/Glass.Label"
        android:layout_marginTop="6dp"
        android:text="Cỡ chữ: 22 sp"
        android:textSize="13sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPanelSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1"
        android:value="22"
        android:valueFrom="10"
        android:valueTo="60"
        app:haloColor="#33FFFFFF"
        app:labelBehavior="gone"
        app:thumbColor="#FFFFFFFF"
        app:thumbElevation="0dp"
        app:trackColorActive="#FFFFFFFF"
        app:trackColorInactive="#55FFFFFF"
        app:trackHeight="3dp" />

    <TextView
        android:id="@+id/tvPanelOpacity"
        style="@style/Glass.Label"
        android:text="Độ đậm chữ: 100%"
        android:textSize="13sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPanelOpacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="5"
        android:value="100"
        android:valueFrom="20"
        android:valueTo="100"
        app:haloColor="#33FFFFFF"
        app:labelBehavior="gone"
        app:thumbColor="#FFFFFFFF"
        app:thumbElevation="0dp"
        app:trackColorActive="#FFFFFFFF"
        app:trackColorInactive="#55FFFFFF"
        app:trackHeight="3dp" />

    <TextView
        android:id="@+id/tvPanelGlass"
        style="@style/Glass.Label"
        android:text="Độ trong kính: 65%"
        android:textSize="13sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPanelGlass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="5"
        android:value="65"
        android:valueFrom="20"
        android:valueTo="100"
        app:haloColor="#33FFFFFF"
        app:labelBehavior="gone"
        app:thumbColor="#FFFFFFFF"
        app:thumbElevation="0dp"
        app:trackColorActive="#FFFFFFFF"
        app:trackColorInactive="#55FFFFFF"
        app:trackHeight="3dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/panelColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPanelHide"
            style="@style/Glass.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minHeight="38dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Tắt"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnPanelSettings"
            style="@style/Glass.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minHeight="38dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Cài đặt"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnPanelClose"
            style="@style/Glass.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="38dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Đóng"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>