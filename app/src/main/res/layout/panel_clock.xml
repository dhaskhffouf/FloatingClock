<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/Glass.Label"
        android:text="Đồng hồ nổi"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPanelCredit"
        style="@style/Glass.Hint"
        android:layout_marginTop="2dp"
        android:text="by Minh Thái" />

    <TextView
        android:id="@+id/tvPanelSize"
        style="@style/Glass.Label"
        android:layout_marginTop="12dp"
        android:text="Cỡ chữ: 22 sp"
        android:textSize="16sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPanelSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1"
        android:value="22"
        android:valueFrom="10"
        android:valueTo="60"
        app:haloColor="#33FFFFFF"
        app:labelBehavior="gone"
        app:thumbColor="#FFFFFFFF"
        app:thumbElevation="0dp"
        app:trackColorActive="#FFFFFFFF"
        app:trackColorInactive="#55FFFFFF"
        app:trackHeight="4dp" />

    <TextView
        android:id="@+id/tvPanelOpacity"
        style="@style/Glass.Label"
        android:text="Độ đậm: 100%"
        android:textSize="16sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPanelOpacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="5"
        android:value="100"
        android:valueFrom="20"
        android:valueTo="100"
        app:haloColor="#33FFFFFF"
        app:labelBehavior="gone"
        app:thumbColor="#FFFFFFFF"
        app:thumbElevation="0dp"
        app:trackColorActive="#FFFFFFFF"
        app:trackColorInactive="#55FFFFFF"
        app:trackHeight="4dp" />

    <TextView
        style="@style/Glass.Label"
        android:text="Màu chữ"
        android:textSize="16sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/panelColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPanelHide"
            style="@style/Glass.Button"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Tắt đồng hồ"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPanelSettings"
            style="@style/Glass.Button"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Cài đặt"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnPanelClose"
        style="@style/Glass.Button"
        android:text="Đóng"
        android:textSize="15sp" />
</LinearLayout>
